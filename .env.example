# Copy to .env.local for local development. On Vercel, add these under Project → Settings → Environment Variables.

# ---- Core ----
# Neon Postgres. The Vercel ↔ Neon integration sets both automatically.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Neon Auth (sign-in). The branch's Auth URL from Neon Console → Auth (or `neon env pull`).
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.c-N.us-east-2.aws.neon.tech/neondb/auth
# Signs the cached session cookie. 32+ characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Encrypts social-account tokens at rest. Generate with: openssl rand -base64 32  (never change it after launch)
TOKEN_ENCRYPTION_KEY=
# Vercel Cron sends this as a Bearer token to /api/cron/publish. Any long random string.
CRON_SECRET=
# Public URL of the app, used for OAuth callbacks and invite links. Optional on Vercel production.
APP_URL=https://scheduleforyou.com

# ---- Media storage: Neon Object Storage ----
# From the Neon Console: Connect → Storage. Branch-scoped. Vercel reserves Neon's AWS_* names,
# so copy the values into these STORAGE_* names (AWS_* also work locally, outside Vercel).
# Neon's AWS_ENDPOINT_URL_S3, e.g. https://br-xxxx.storage.c-N.us-east-2.aws.neon.tech
STORAGE_ENDPOINT=
# Neon's AWS_ACCESS_KEY_ID (nak_live_…) and AWS_SECRET_ACCESS_KEY (nsk_live_…)
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=us-east-2
# Bucket declared in neon.ts. Change only if you use another bucket.
STORAGE_BUCKET=sfy-media
# Optional: CDN in front of the bucket. Without it, platforms get 24-hour signed URLs.
STORAGE_PUBLIC_URL=

# ---- Or Cloudflare R2 (used only when the storage variables above are empty) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---- Email (Resend): reminders, failure alerts, daily digest, team invites ----
RESEND_API_KEY=
# Sender on a domain verified in Resend (Resend → Domains).
EMAIL_FROM=Schedule For You <notifications@scheduleforyou.com>

# ---- Testing ----
# 1 = pretend to publish (no platform calls). Never set in production.
SFY_DRY_RUN=

# ---- Platforms (Bluesky needs nothing) ----
X_CLIENT_ID=
X_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
